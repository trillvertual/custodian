{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx"
  },
  "include": [
    "apps/server/src",
    "packages",
    "tests",
    "scripts",
    "playwright.config.ts"
  ]
}
